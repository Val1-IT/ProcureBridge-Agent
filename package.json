{
  "name": "arvanta-procurebridge-recovery-agent",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "judge:build": "vite build --config vite.dealtwin.config.ts",
    "judge:demo": "node scripts/dealtwin/local-demo.mjs",
    "judge:test": "node node_modules/vite-node/vite-node.mjs --config vitest.config.ts scripts/dealtwin/prepare-browser-fixture.ts && playwright test --config=playwright.dealtwin.config.ts",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:client": "node scripts/dealtwin/check-client-artifacts.mjs dist/client",
    "benchmark:dealtwin": "node node_modules/vite-node/vite-node.mjs --config vitest.config.ts evaluation/dealtwin/cli.ts --",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "15.5.28",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.23",
    "image-size": "2.0.4",
    "ws": "8.21.0",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.28",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "vitest": "3.2.7",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
